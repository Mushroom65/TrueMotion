{"id":"legacy-c56c00aa5abe","runtimeId":"tmold.com.alightcreative.effects.vt2.k-neon-flicker","sourceId":"com.alightcreative.effects.vt2.k-neon-flicker","name":"Neon Flicker","category":"legacy-text","description":"Random letters blank out like a failing neon sign.","params":[{"id":"amount","label":"Amount","shaderId":"amzp_amount","type":"float","default":0.2,"min":0.0,"max":1.0,"step":0.01,"percent":true},{"id":"speed","label":"Speed","shaderId":"amzp_speed","type":"float","default":10.0,"min":0.0,"max":400.0,"step":0.1},{"id":"seed","label":"Seed","shaderId":"amzp_seed","type":"float","default":0.0,"min":0.0,"max":25.0,"step":0.01}],"dialect":"legacy","native":true,"stages":[],"legacyScript":"\n        function animate(env,el,p){ var t=el.text,o=\"\"; for(var i=0;i<t.length;i++){ var r=(AM.simplexNoise(i*7.7, p.seed+Math.floor(env.absTime*p.speed))+1)/2; o += (r<p.amount) ? \" \" : t.charAt(i); } el.text=o; return el; }\n    ","iterations":null,"textures":[],"sourceFile":"ampro_vt2-k-neon-flicker.xml","sourceSha256":"9a1a08616f31325d1e2e553d6b5aa417e7671ba99b11b1beb1606606f851236e","sksl":null}
