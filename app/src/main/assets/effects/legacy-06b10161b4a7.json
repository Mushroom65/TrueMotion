{"id":"legacy-06b10161b4a7","runtimeId":"tmold.com.alightcreative.effects.swing","sourceId":"com.alightcreative.effects.swing","name":"Swing","category":"legacy-transform","description":"Automatically rotates the layer back and forth over time.","params":[{"id":"freq","label":"Frequency","shaderId":"amzp_freq","type":"float","default":2.0,"min":0.1,"max":16.0,"step":0.01},{"id":"a1","label":"Angle 1","shaderId":"amzp_a1","type":"angle","default":-30.0,"min":-180.0,"max":180.0,"step":0.1},{"id":"a2","label":"Angle 2","shaderId":"amzp_a2","type":"angle","default":30.0,"min":-180.0,"max":180.0,"step":0.1},{"id":"phase","label":"Starting Phase","shaderId":"amzp_phase","type":"float","default":0.0,"min":0.0,"max":200.0,"step":0.01},{"id":"type","label":"Wave","shaderId":"amzp_type","type":"choice","default":0.0,"options":["Sine","Triangle"],"optionValues":[0.0,1.0]}],"dialect":"legacy","native":true,"stages":[],"legacyScript":"\n\n        function animate(env,el,p) {\n            let t = env.time;\n            let m\n            if( p.type == 0 ) {\n                m = Math.sin(((t * env.duration * p.freq)+p.phase) * 3.14159)\n            } else {\n                m = AM.triangle(((t * env.duration * p.freq)+p.phase) / 2.0)\n            }\n            el.transform.angle += ((p.a2 - p.a1) * ((m+1.0)/2.0) ) + p.a1;\n            return el;\n        }\n\n    ","iterations":null,"textures":[],"sourceFile":"swing.xml","sourceSha256":"6bfe1573ade06c89560de05e0f4da51ac22eb9be01dacd283c0a2f97f35cabf9","sksl":null}
