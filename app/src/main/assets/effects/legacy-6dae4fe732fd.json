{"id":"legacy-6dae4fe732fd","runtimeId":"tmold.com.alightcreative.effects.extratext.tx-repeat","sourceId":"com.alightcreative.effects.extratext.tx-repeat","name":"Repeat","category":"legacy-text","description":"Repeats the text a number of times.","params":[{"id":"count","label":"Times","shaderId":"amzp_count","type":"float","default":3.0,"min":1.0,"max":20.0,"step":1.0},{"id":"newline","label":"New Line","shaderId":"amzp_newline","type":"switch","default":false}],"dialect":"legacy","native":true,"stages":[],"legacyScript":"\n        function animate(env,el,p){\n            var n=Math.max(1,Math.round(p.count)), sep=p.newline?\"\\n\":\" \", a=[];\n            for(var i=0;i<n;i++) a.push(el.text);\n            el.text=a.join(sep); return el;\n        }\n    ","iterations":null,"textures":[],"sourceFile":"ampro_extratext-tx-repeat.xml","sourceSha256":"26f53838fbde9e6c3705ab1b1d7af4729cdf79a04f86f4bf47d9508cc9c407c6","sksl":null}
