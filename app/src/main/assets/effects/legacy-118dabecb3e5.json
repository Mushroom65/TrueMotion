{"id":"legacy-118dabecb3e5","runtimeId":"tmold.com.alightcreative.effects.extratext.num-hex","sourceId":"com.alightcreative.effects.extratext.num-hex","name":"Hexadecimal","category":"legacy-text","description":"Converts whole numbers to hexadecimal.","params":[{"id":"prefix","label":"0x Prefix","shaderId":"amzp_prefix","type":"switch","default":true}],"dialect":"legacy","native":true,"stages":[],"legacyScript":"\n        function animate(env,el,p){ el.text=el.text.replace(/\\d+/g, function(s){ var h=(parseInt(s,10)>>>0).toString(16).toUpperCase(); return (p.prefix?\"0x\":\"\")+h; }); return el; }\n    ","iterations":null,"textures":[],"sourceFile":"ampro_extratext-num-hex.xml","sourceSha256":"49465a6e80aca2d7240da1aa6687790dcfc80078a733e080741d2d8015ed955a","sksl":null}
