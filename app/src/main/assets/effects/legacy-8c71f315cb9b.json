{"id":"legacy-8c71f315cb9b","runtimeId":"tmold.com.alightcreative.effects.extratext.tx-spaced","sourceId":"com.alightcreative.effects.extratext.tx-spaced","name":"S P A C E D","category":"legacy-text","description":"Inserts spaces between every character.","params":[{"id":"gap","label":"Gap","shaderId":"amzp_gap","type":"float","default":1.0,"min":1.0,"max":6.0,"step":1.0}],"dialect":"legacy","native":true,"stages":[],"legacyScript":"\n        function animate(env,el,p){\n            var g=Math.max(1,Math.round(p.gap)), sp=\"\";\n            for(var k=0;k<g;k++) sp+=\" \";\n            el.text=el.text.split(\"\").join(sp); return el;\n        }\n    ","iterations":null,"textures":[],"sourceFile":"ampro_extratext-tx-spaced.xml","sourceSha256":"d2e784b7dbae84e1bbece19cf405081d6b66f79cf0116516de4e185987004b9b","sksl":null}
