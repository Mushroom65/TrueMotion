{"id":"legacy-f2ff822e6832","runtimeId":"tmold.com.alightcreative.effects.tx3.t-spaceout","sourceId":"com.alightcreative.effects.tx3.t-spaceout","name":"Space Out Words","category":"legacy-text","description":"Adds wide spacing between words.","params":[{"id":"gap","label":"Gap","shaderId":"amzp_gap","type":"float","default":3.0,"min":1.0,"max":10.0,"step":1.0}],"dialect":"legacy","native":true,"stages":[],"legacyScript":"\n        function animate(env,el,p){ var g=Math.round(p.gap),sp=\"\"; for(var k=0;k<g;k++)sp+=\" \"; el.text=el.text.trim().split(/\\s+/).join(sp); return el; }\n    ","iterations":null,"textures":[],"sourceFile":"ampro_tx3-t-spaceout.xml","sourceSha256":"439607c2409330ceb54278712adfde142cce8e8559cdbbbdc598f2fbcaef7a6f","sksl":null}
