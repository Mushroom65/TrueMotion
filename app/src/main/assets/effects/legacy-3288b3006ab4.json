{"id":"legacy-3288b3006ab4","runtimeId":"tmold.com.alightcreative.effects.smooth_transform_tileshift","sourceId":"com.alightcreative.effects.smooth_transform_tileshift","name":"blurmocurves","category":"legacy-transform","description":"Smooth transformation with optional tile displacement and blur","params":[{"id":"posz","label":"Z Dist","shaderId":"amzp_posz","type":"float","default":1.0,"min":0.001,"max":30.0,"step":0.005},{"id":"posx","label":"Shift X","shaderId":"amzp_posx","type":"float","default":0.0,"min":-8192.0,"max":8192.0,"step":0.5},{"id":"posy","label":"Shift Y","shaderId":"amzp_posy","type":"float","default":0.0,"min":-8192.0,"max":8192.0,"step":0.5},{"id":"angle","label":"Rotate","shaderId":"amzp_angle","type":"angle","default":0.0,"min":-360000.0,"max":360000.0,"step":0.5},{"id":"zinv","label":"Invert Z","shaderId":"amzp_zinv","type":"switch","default":false},{"id":"xinv","label":"Invert X","shaderId":"amzp_xinv","type":"switch","default":false},{"id":"yinv","label":"Invert Y","shaderId":"amzp_yinv","type":"switch","default":false},{"id":"ainv","label":"Invert Angle","shaderId":"amzp_ainv","type":"switch","default":false},{"id":"tileEnable","label":"Enable TileShift","shaderId":"amzp_tileEnable","type":"switch","default":false},{"id":"tileStrength","label":"Tile Strength","shaderId":"amzp_tileStrength","type":"float","default":0.1,"min":0.0,"max":1.0,"step":0.01},{"id":"tileAmount","label":"Tile Count","shaderId":"amzp_tileAmount","type":"float","default":10.0,"min":1.0,"max":200.0,"step":0.5},{"id":"tileSeed","label":"Tile Random Seed","shaderId":"amzp_tileSeed","type":"float","default":0.0,"min":0.0,"max":5.0,"step":0.01},{"id":"motionBlurAmount","label":"Motion Blur Amount","shaderId":"amzp_motionBlurAmount","type":"float","default":0.3,"min":0.0,"max":1.0,"step":0.01}],"dialect":"legacy","native":true,"stages":[],"legacyScript":"\n        function animate(env, el, p) {\n            var x = p.xinv ? -p.posx : p.posx;\n            var y = p.yinv ? -p.posy : p.posy;\n            var z = p.zinv ? 1 + (1 - p.posz) : p.posz;\n            var a = p.ainv ? -p.angle : p.angle;\n\n            el.transform.location.x += x;\n            el.transform.location.y += y;\n            el.transform.angle += a;\n            el.transform.scale.x += z - 1;\n            el.transform.scale.y += z - 1;\n            return el;\n        }\n    ","iterations":null,"textures":[],"sourceFile":"blurmocurves.xml","sourceSha256":"f65fb606c55c35bd8530ab54cc061061819a13636993084a5b3f44d3f2c6c646","sksl":null}
