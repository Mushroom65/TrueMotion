{"id":"legacy-c739d8ec6982","runtimeId":"tmold.com.alightcreative.effects.swing2","sourceId":"com.alightcreative.effects.swing2","name":"Swing","category":"legacy-transform","description":"Automatically rotates the layer back and forth over time.","params":[{"id":"freq","label":"Frequency","shaderId":"amzp_freq","type":"float","default":2.0,"min":0.1,"max":16.0,"step":0.01},{"id":"a1","label":"Angle 1","shaderId":"amzp_a1","type":"angle","default":-30.0,"min":-180.0,"max":180.0,"step":0.1},{"id":"a2","label":"Angle 2","shaderId":"amzp_a2","type":"angle","default":30.0,"min":-180.0,"max":180.0,"step":0.1},{"id":"phase","label":"Phase","shaderId":"amzp_phase","type":"float","default":0.0,"min":0.0,"max":200.0,"step":0.01},{"id":"type","label":"Wave","shaderId":"amzp_type","type":"choice","default":0.0,"options":["Sine","Triangle"],"optionValues":[0.0,1.0]}],"dialect":"legacy","native":true,"stages":[],"legacyScript":"\n\n        function animate(env,el,p) {\n            let t = env.time;\n            let m\n            if( p.type == 0 ) {\n                m = Math.sin((p.freq+p.phase) * 3.14159)\n            } else {\n                m = AM.triangle((p.freq+p.phase) / 2.0)\n            }\n            el.transform.angle += ((p.a2 - p.a1) * ((m+1.0)/2.0) ) + p.a1;\n            return el;\n        }\n\n    ","iterations":null,"textures":[],"sourceFile":"swing2.xml","sourceSha256":"2453642f8d8202c0f1857199ffb8b5bab8a8ebd63b22d15b5dd1b9c48807c3f0","sksl":null}
