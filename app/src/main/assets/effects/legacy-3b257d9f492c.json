{"id":"legacy-3b257d9f492c","runtimeId":"tmold.com.alightcreative.effects.vt.n-padzeros","sourceId":"com.alightcreative.effects.vt.n-padzeros","name":"Pad Zeros","category":"legacy-text","description":"Pads numbers with leading zeros.","params":[{"id":"width","label":"Width","shaderId":"amzp_width","type":"float","default":4.0,"min":1.0,"max":12.0,"step":1.0}],"dialect":"legacy","native":true,"stages":[],"legacyScript":"\n        function animate(env,el,p){ var w=Math.round(p.width); el.text=el.text.replace(/\\d+/g,function(s){ while(s.length<w)s=\"0\"+s; return s; }); return el; }\n    ","iterations":null,"textures":[],"sourceFile":"ampro_vt-n-padzeros.xml","sourceSha256":"7eb3cbab356c61bbe320f632021a71e9b4fb9efef4c3f82cb050034fd618c3dc","sksl":null}
