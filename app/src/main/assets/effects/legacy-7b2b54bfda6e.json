{"id":"legacy-7b2b54bfda6e","runtimeId":"tmold.com.custom.effects.New_shake","sourceId":"com.custom.effects.New_shake","name":"pose shake","category":"legacy-transform","description":"XY and rotation shake driven by sin(time · gamma · beta)","params":[{"id":"Xmag","label":"X Magnitude","shaderId":"amzp_Xmag","type":"float","default":25.0,"min":0.0,"max":500.0,"step":0.5},{"id":"Ymag","label":"Y Magnitude","shaderId":"amzp_Ymag","type":"float","default":25.0,"min":0.0,"max":500.0,"step":0.5},{"id":"rotMag","label":"Rotation Magnitude","shaderId":"amzp_rotMag","type":"angle","default":3.0,"min":0.0,"max":180.0,"step":0.1},{"id":"gamma","label":"Gamma (frequency)","shaderId":"amzp_gamma","type":"float","default":12.0,"min":0.0,"max":30.0,"step":0.1},{"id":"beta","label":"Beta (intensity)","shaderId":"amzp_beta","type":"float","default":1.0,"min":0.0,"max":5.0,"step":0.01}],"dialect":"legacy","native":true,"stages":[],"legacyScript":"\n\n        function animate(env, el, p) {\n            var t = env.frame / env.fps;\n\n            var freq = p.gamma * p.beta;\n\n            el.transform.location.x += Math.sin(t * freq)         * p.Xmag;\n            el.transform.location.y += Math.sin(t * freq + 1.047) * p.Ymag * 0.7;\n            el.transform.angle      += Math.sin(t * freq + 2.094) * p.rotMag;\n\n            return el;\n        }\n\n    ","iterations":null,"textures":[],"sourceFile":"pose_shake.xml","sourceSha256":"a6f4f4a947fad649cb701850e86e2077bdfa60667dc80fc11da0947aad67aa26","sksl":null}
