{"id":"legacy-fae4ab69e608","runtimeId":"tmold.com.alightcreative.effects.extratext.tx-smallcaps","sourceId":"com.alightcreative.effects.extratext.tx-smallcaps","name":"Small Caps","category":"legacy-text","description":"Converts lowercase letters into small capitals.","params":[],"dialect":"legacy","native":true,"stages":[],"legacyScript":"\n        function animate(env,el,p){\n            var m={\"a\":\"\\u1D00\",\"b\":\"\\u0299\",\"c\":\"\\u1D04\",\"d\":\"\\u1D05\",\"e\":\"\\u1D07\",\"f\":\"\\uA730\",\"g\":\"\\u0262\",\"h\":\"\\u029C\",\"i\":\"\\u026A\",\"j\":\"\\u1D0A\",\"k\":\"\\u1D0B\",\"l\":\"\\u029F\",\"m\":\"\\u1D0D\",\"n\":\"\\u0274\",\"o\":\"\\u1D0F\",\"p\":\"\\u1D18\",\"q\":\"q\",\"r\":\"\\u0280\",\"s\":\"s\",\"t\":\"\\u1D1B\",\"u\":\"\\u1D1C\",\"v\":\"\\u1D20\",\"w\":\"\\u1D21\",\"x\":\"x\",\"y\":\"\\u028F\",\"z\":\"\\u1D22\"};\n            var t=el.text.toLowerCase(),out=\"\";\n            for(var i=0;i<t.length;i++){ var c=t.charAt(i); out+= m[c]||c; }\n            el.text=out; return el;\n        }\n    ","iterations":null,"textures":[],"sourceFile":"ampro_extratext-tx-smallcaps.xml","sourceSha256":"3bbd50bb5e6cc7d9bb05057319deaf1c932d2b4a51bd265437bd7002526b0a04","sksl":null}
