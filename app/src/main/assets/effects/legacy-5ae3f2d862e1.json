{"id":"legacy-5ae3f2d862e1","runtimeId":"tmold.com.alightcreative.effects.pulseopacity2","sourceId":"com.alightcreative.effects.pulseopacity2","name":"Pulse Opacity","category":"legacy-opacity","description":"Automatically pulses the layer opacity over time, based on a sine wave or triangular wave.","params":[{"id":"freq","label":"Frequency","shaderId":"amzp_freq","type":"float","default":2.0,"min":0.1,"max":16.0,"step":0.01},{"id":"strength","label":"Strength","shaderId":"amzp_strength","type":"float","default":1.0,"min":0.0,"max":1.0,"step":0.01,"percent":true},{"id":"phase","label":"Starting Phase","shaderId":"amzp_phase","type":"float","default":0.0,"min":0.0,"max":200.0,"step":0.01},{"id":"type","label":"Wave","shaderId":"amzp_type","type":"choice","default":0.0,"options":["Sine","Triangle"],"optionValues":[0.0,1.0]}],"dialect":"legacy","native":true,"stages":[],"legacyScript":"\n\n        function animate(env,el,p) {\n            let t = env.time;\n            let m\n            if( p.type == 0 ) {\n                m = Math.sin((p.freq+p.phase) * 3.14159)\n            } else {\n                m = AM.triangle((p.freq+p.phase) / 2.0)\n            }\n            m = (m + 1.0)/2.0;\n            el.alpha *= (1-p.strength) + (m*p.strength);\n            return el;\n        }\n\n    ","iterations":null,"textures":[],"sourceFile":"pulse_opacity2.xml","sourceSha256":"9caa0d5bdfcc0f36a36129aa80fd95d34ede3c894c590db231dccefcbd4491f9","sksl":null}
