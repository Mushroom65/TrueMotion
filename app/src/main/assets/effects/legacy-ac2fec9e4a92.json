{"id":"legacy-ac2fec9e4a92","runtimeId":"tmold.com.alightcreative.effects.vt.a-wavespace","sourceId":"com.alightcreative.effects.vt.a-wavespace","name":"Wave Spacing","category":"legacy-text","description":"Animated breathing space between letters.","params":[{"id":"speed","label":"Speed","shaderId":"amzp_speed","type":"float","default":3.0,"min":0.0,"max":200.0,"step":0.1}],"dialect":"legacy","native":true,"stages":[],"legacyScript":"\n        function animate(env,el,p){ var g=Math.round((Math.sin(env.absTime*p.speed)*0.5+0.5)*3.0); var sp=\"\"; for(var k=0;k<g;k++)sp+=\" \"; el.text=el.text.split(\"\").join(sp); return el; }\n    ","iterations":null,"textures":[],"sourceFile":"ampro_vt-a-wavespace.xml","sourceSha256":"813a667daed9a2537ebee1de97290abfb1884a7379982485b4cf75f47f36199d","sksl":null}
