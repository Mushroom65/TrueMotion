{
  "id": "true-spectrum",
  "runtimeId": "lab.true.spectrum",
  "name": "Audio spectrum",
  "category": "true",
  "native": true,
  "description": "Real stereo FFT spectrum driven by an audio/video layer or the project mix. Cached analysis, seven display styles, live controls and keyframes.",
  "params": [
    {
      "id": "style",
      "label": "Display",
      "type": "choice",
      "default": 0,
      "options": [
        "Bars",
        "Line",
        "Filled area",
        "Radial bars",
        "Radial line",
        "Dots",
        "Radial area"
      ]
    },
    {
      "id": "sourceLayer",
      "label": "Audio source",
      "type": "text",
      "default": "0"
    },
    {
      "id": "count",
      "label": "Bands",
      "type": "float",
      "default": 64,
      "min": 4,
      "max": 256,
      "step": 1
    },
    {
      "id": "width",
      "label": "Width",
      "type": "float",
      "default": 600,
      "min": 1,
      "max": 10000,
      "step": 1
    },
    {
      "id": "height",
      "label": "Height",
      "type": "float",
      "default": 240,
      "min": 1,
      "max": 10000,
      "step": 1
    },
    {
      "id": "radius",
      "label": "Radius",
      "type": "float",
      "default": 100,
      "min": 0,
      "max": 10000,
      "step": 1
    },
    {
      "id": "thickness",
      "label": "Thickness",
      "type": "float",
      "default": 4,
      "min": 0.1,
      "max": 1000,
      "step": 0.1
    },
    {
      "id": "gap",
      "label": "Bar gap",
      "type": "float",
      "default": 0.25,
      "min": 0,
      "max": 0.95,
      "step": 0.01
    },
    {
      "id": "angle",
      "label": "Start angle",
      "type": "float",
      "default": -90,
      "min": -36000,
      "max": 36000,
      "step": 1
    },
    {
      "id": "sweep",
      "label": "Arc angle",
      "type": "float",
      "default": 360,
      "min": 1,
      "max": 360,
      "step": 1
    },
    {
      "id": "minimum",
      "label": "Minimum level",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    {
      "id": "glow",
      "label": "Glow",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "id": "gain",
      "label": "Gain",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 20,
      "step": 0.01
    },
    {
      "id": "gate",
      "label": "Noise gate",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 0.99,
      "step": 0.01
    },
    {
      "id": "attackMs",
      "label": "Attack (ms)",
      "type": "float",
      "default": 15,
      "min": 0,
      "max": 2000,
      "step": 1
    },
    {
      "id": "releaseMs",
      "label": "Release (ms)",
      "type": "float",
      "default": 150,
      "min": 0,
      "max": 5000,
      "step": 1
    },
    {
      "id": "minHz",
      "label": "Minimum frequency (Hz)",
      "type": "float",
      "default": 20,
      "min": 20,
      "max": 22049,
      "step": 1
    },
    {
      "id": "maxHz",
      "label": "Maximum frequency (Hz)",
      "type": "float",
      "default": 18000,
      "min": 21,
      "max": 22050,
      "step": 1
    },
    {
      "id": "floorDb",
      "label": "Noise floor (dB)",
      "type": "float",
      "default": -60,
      "min": -120,
      "max": -1,
      "step": 1
    },
    {
      "id": "offsetMs",
      "label": "Audio offset (ms)",
      "type": "float",
      "default": 0,
      "min": -30000,
      "max": 30000,
      "step": 1
    },
    {
      "id": "mirror",
      "label": "Mirror",
      "type": "switch",
      "default": false
    },
    {
      "id": "reverse",
      "label": "Reverse frequencies",
      "type": "switch",
      "default": false
    },
    {
      "id": "normalize",
      "label": "Normalize",
      "type": "switch",
      "default": true
    },
    {
      "id": "respectVolume",
      "label": "Respect layer volume",
      "type": "switch",
      "default": true
    },
    {
      "id": "colorLow",
      "label": "Low color",
      "type": "color",
      "default": "#ff1ae6cc"
    },
    {
      "id": "colorHigh",
      "label": "High color",
      "type": "color",
      "default": "#ffcc40ff"
    }
  ]
}
