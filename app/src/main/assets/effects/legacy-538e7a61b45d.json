{"id":"legacy-538e7a61b45d","runtimeId":"tmold.com.alightcreative.effects.vt2.f-truncate","sourceId":"com.alightcreative.effects.vt2.f-truncate","name":"Truncate","category":"legacy-text","description":"Cuts the text to a max length with an ellipsis.","params":[{"id":"maxLen","label":"Max Length","shaderId":"amzp_maxLen","type":"float","default":12.0,"min":1.0,"max":80.0,"step":1.0}],"dialect":"legacy","native":true,"stages":[],"legacyScript":"\n        function animate(env,el,p){ var n=Math.round(p.maxLen); if(el.text.length>n) el.text=el.text.slice(0,Math.max(0,n-1))+\"…\"; return el; }\n    ","iterations":null,"textures":[],"sourceFile":"ampro_vt2-f-truncate.xml","sourceSha256":"83ab10d9101fac431282455a7995b4905cbede7eb9b83e4336577c297ca7a71d","sksl":null}
