{"id":"legacy-3628b39064d2","runtimeId":"tmold.com.alightcreative.effects.vt2.m-random","sourceId":"com.alightcreative.effects.vt2.m-random","name":"Random Number","category":"legacy-text","description":"Shows a random number that reshuffles over time.","params":[{"id":"lo","label":"Min","shaderId":"amzp_lo","type":"float","default":0.0,"min":-9999.0,"max":9999.0,"step":1.0},{"id":"hi","label":"Max","shaderId":"amzp_hi","type":"float","default":99.0,"min":-9999.0,"max":9999.0,"step":1.0},{"id":"speed","label":"Speed","shaderId":"amzp_speed","type":"float","default":4.0,"min":0.01,"max":300.0,"step":0.1},{"id":"seed","label":"Seed","shaderId":"amzp_seed","type":"float","default":0.0,"min":0.0,"max":25.0,"step":0.01}],"dialect":"legacy","native":true,"stages":[],"legacyScript":"\n        function animate(env,el,p){ var r=(AM.simplexNoise(Math.floor(env.absTime*p.speed)*1.7, p.seed)+1)/2; var lo=Math.min(p.lo,p.hi), hi=Math.max(p.lo,p.hi); el.text=\"\"+Math.floor(lo + r*(hi-lo+1)); return el; }\n    ","iterations":null,"textures":[],"sourceFile":"ampro_vt2-m-random.xml","sourceSha256":"93de6e1028faf32f3de0137316b8e6c637573f728dbce7546d533eebbe004812","sksl":null}
