{"id":"legacy-a9013077f58e","runtimeId":"tmold.com.alightcreative.effects.vt2.m-clamp","sourceId":"com.alightcreative.effects.vt2.m-clamp","name":"Clamp Numbers","category":"legacy-text","description":"Limits numbers between a min and max.","params":[{"id":"lo","label":"Min","shaderId":"amzp_lo","type":"float","default":0.0,"min":-9999.0,"max":9999.0,"step":1.0},{"id":"hi","label":"Max","shaderId":"amzp_hi","type":"float","default":100.0,"min":-9999.0,"max":9999.0,"step":1.0}],"dialect":"legacy","native":true,"stages":[],"legacyScript":"\n        function animate(env,el,p){ el.text=el.text.replace(/-?\\d+(\\.\\d+)?/g,function(s){ var n=parseFloat(s); return \"\"+Math.min(Math.max(n,p.lo),p.hi); }); return el; }\n    ","iterations":null,"textures":[],"sourceFile":"ampro_vt2-m-clamp.xml","sourceSha256":"78a3e658566f9acb95b5244384f3b0a4e307bd09508f9454ea0eed0652f0ac54","sksl":null}
